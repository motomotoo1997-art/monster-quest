[node name="Main" type="Node"]
script = ExtResource("1_main")
hopper_scene = ExtResource("14_hopper")
sentinel_scene = ExtResource("15_sentinel")
disc_scene = ExtResource("16_disc")
slime_scene = ExtResource("17_slime")
boss_scene = ExtResource("24_boss")

[node name="ArenaLayer" type="Node2D" parent="."]

[node name="Actors" type="Node2D" parent="."]
y_sort_enabled = true

[node name="Prospector" parent="Actors" instance=ExtResource("7_player")]

[node name="GoldCore" parent="Actors" instance=ExtResource("8_core")]

[node name="RunController" type="Node" parent="."]
script = ExtResource("2_run")

[node name="ArenaController" type="Node" parent="." node_paths=PackedStringArray("arena_container_path")]
script = ExtResource("3_arena_controller")
arena_scenes = Array[PackedScene]([ExtResource("9_arena1"), ExtResource("10_arena2"), ExtResource("11_arena3"), ExtResource("12_arena4"), ExtResource("13_arena5")])
arena_container_path = NodePath("../ArenaLayer")

[node name="WaveDirector" type="Node" parent="." node_paths=PackedStringArray("arena_controller_path", "player_path", "core_path")]
script = ExtResource("4_wave")
arena_controller_path = NodePath("../ArenaController")
player_path = NodePath("../Actors/Prospector")
core_path = NodePath("../Actors/GoldCore")
gold_pickup_scene = ExtResource("21_gold")

[node name="EconomyController" type="Node" parent="."]
script = ExtResource("5_economy")
starting_gold = 65

[node name="BuildController" type="Node" parent="." node_paths=PackedStringArray("economy_path")]
script = ExtResource("6_build")
economy_path = NodePath("../EconomyController")
defense_scenes = Array[PackedScene]([ExtResource("18_magnetic"), ExtResource("19_cactus"), ExtResource("20_tnt")])

[node name="UpgradeController" type="Node" parent="." node_paths=PackedStringArray("player_path", "economy_path", "build_controller_path")]
script = ExtResource("22_upgrade_controller")
player_path = NodePath("../Actors/Prospector")
economy_path = NodePath("../EconomyController")
build_controller_path = NodePath("../BuildController")

[node name="UpgradeOverlay" parent="." instance=ExtResource("23_upgrade_overlay")]
